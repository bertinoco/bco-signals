{
  "_comment": "Discovery finds company boards; the weekly poll then sees every job on them. Each query is run once per host as `site:<host> <terms>`. Keep each under Google's 32-word limit.",
  "hosts": [
    "jobs.ashbyhq.com",
    "jobs.lever.co",
    "jobs.eu.lever.co",
    "job-boards.greenhouse.io",
    "boards.greenhouse.io",
    "job-boards.eu.greenhouse.io"
  ],
  "queries": [
    "\"content designer\" OR \"content design\"",
    "\"UX writer\" OR \"UX writing\"",
    "\"content strategist\"",
    "\"conversation designer\" OR \"conversational designer\"",
    "\"content engineer\" OR \"content architect\"",
    "\"language systems\" OR \"taxonomist\"",
    "\"content systems\""
  ],
  "skip_boards": {
    "_comment": "Boards never polled or added by discovery: job aggregators, referral and internal boards, ad agencies, and language-annotation or AI-training vendors whose postings are all out of scope.",
    "boards": [
      "greenhouse-eu/agency",
      "greenhouse/coupanginternal",
      "greenhouse/mrbeastyoutube",
      "greenhouse/referralsuseonly",
      "greenhouse/wundermanthompson",
      "greenhouse/ziprecruiter",
      "lever-eu/lionbridge",
      "lever/appen",
      "lever/appen-2",
      "lever/jobgether",
      "lever/tsmg",
      "lever/veeva",
      "lever/weekdayworks",
      "lever/weloglobal"
    ]
  }
}
